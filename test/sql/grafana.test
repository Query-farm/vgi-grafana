# ------------------------------------------------------------------ ds_query

query TTTRT
SELECT ref_id, field, ts, value, string_value FROM grafana.main.ds_query('testdata', '{"scenarioId": "csv_metric_values", "stringInput": "1,20,90", "alias": "cpu"}', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-01-01 01:00:00+00') ORDER BY ts;
----
A	cpu	2026-01-01 00:00:00+00	1.0	NULL
A	cpu	2026-01-01 00:30:00+00	20.0	NULL
A	cpu	2026-01-01 01:00:00+00	90.0	NULL

# Several queries in one call; a table frame has no ts.
query TTIRT
SELECT ref_id, field, row_index, value, string_value FROM grafana.main.ds_query('testdata', '[{"scenarioId": "csv_metric_values", "stringInput": "5"}, {"refId": "T", "scenarioId": "csv_content", "csvContent": "name,value,ok\nx,1.5,true\ny,,false"}]', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-01-01 01:00:00+00') WHERE ts IS NULL ORDER BY ref_id, field, row_index;
----
T	name	0	NULL	x
T	name	1	NULL	y
T	ok	0	1.0	true
T	ok	1	0.0	false
T	value	0	1.5	NULL
T	value	1	NULL	NULL

# Labelled series: labels MAP, one row per series and point.
query TII
SELECT labels['env'], count(DISTINCT field), count(*) FROM grafana.main.ds_query('testdata', '{"scenarioId": "random_walk", "seriesCount": 2, "labels": "env=prod", "seed": 7}', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-01-01 01:00:00+00', max_data_points := 6, interval_ms := 600000) GROUP BY ALL;
----
prod	2	12

query I
SELECT count(*) FROM grafana.main.ds_query('testdata', '{"scenarioId": "predictable_pulse", "pulseWave": {"timeStep": 600, "onCount": 1, "offCount": 1, "onValue": 10, "offValue": 1}}', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-01-01 01:00:00+00', interval_ms := 600000) WHERE value = 10;
----
3

statement error
SELECT * FROM grafana.main.ds_query('testdata', 'not json', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-01-01 01:00:00+00');
----
query_json must be a JSON object

statement error
SELECT * FROM grafana.main.ds_query('testdata', '{}', TIMESTAMPTZ '2026-01-01 01:00:00+00', TIMESTAMPTZ '2026-01-01 00:00:00+00');
----
end_time is before start_time

# A data source error names the refId (handwritten.json).
statement error
SELECT * FROM grafana.main.ds_query('broken', '{"expr": "up"}', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-01-01 01:00:00+00');
----
query A on data source broken failed: connection refused

# NaN / +Inf / -Inf entities and extra nanoseconds (handwritten.json).
query TT
SELECT ts::VARCHAR, value::VARCHAR FROM grafana.main.ds_query('entities', '{"expr": "x"}', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-01-01 01:00:00+00') ORDER BY row_index;
----
2026-01-01 00:00:00+00	1.5
2026-01-01 00:00:01.000002+00	nan
2026-01-01 00:00:02+00	inf
2026-01-01 00:00:03+00	-inf
2026-01-01 00:00:04+00	NULL

# ------------------------------------------------------------------ auth, org header, named secrets

# The auth fixture demands a credential and X-Grafana-Org-Id: 1.
statement ok
CREATE SECRET no_org (TYPE grafana, BASE_URL '{GRAFANA_FIXTURE_AUTH_URL}', TOKEN 'test-token');

statement error
SELECT * FROM grafana.main.search(secret_name := 'no_org');
----
HTTP 403

statement ok
CREATE SECRET bad_token (TYPE grafana, BASE_URL '{GRAFANA_FIXTURE_AUTH_URL}', TOKEN 'wrong', ORG_ID '1');

statement error
SELECT * FROM grafana.main.search(secret_name := 'bad_token');
----
HTTP 401

statement ok
CREATE SECRET tok (TYPE grafana, BASE_URL '{GRAFANA_FIXTURE_AUTH_URL}', TOKEN 'test-token', ORG_ID '1', PAGE_SIZE '2');

query T
SELECT uid FROM grafana.main.search(type := 'folder', secret_name := 'tok') ORDER BY uid;
----
ag4doayx5b9xcf
ops
ops-web
sales
sales-emea

statement ok
CREATE SECRET basic (TYPE grafana, BASE_URL '{GRAFANA_FIXTURE_AUTH_URL}', USERNAME 'viewer', PASSWORD 'secret-pw', ORG_ID '1', PAGE_SIZE '2');

query I
SELECT count(*) FROM grafana.main.ds_query('testdata', '{"scenarioId": "csv_metric_values", "stringInput": "1,20,90", "alias": "cpu"}', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-01-01 01:00:00+00', secret_name := 'basic');
----
3

statement error
SELECT * FROM grafana.main.search(secret_name := 'missing');
----
no grafana secret named "missing"

# The ATTACH option secret_name points every catalog table at a named secret.
statement ok
ATTACH 'grafana' AS g2 (TYPE vgi, LOCATION '{GRAFANA_WORKER}', secret_name 'basic');

query TI
SELECT folder_path, count(*) FROM g2.main.dashboards GROUP BY folder_path ORDER BY folder_path;
----
/	1
/Operations	1
/Operations/Web	1
/Sales/EMEA	1

query T
SELECT version FROM g2.main.health;
----
12.1.1

# A credential that cannot list every org falls back to its current org
# (handwritten.json answers /api/orgs with 403 at PAGE_SIZE 7).
statement ok
CREATE SECRET org_viewer (TYPE grafana, BASE_URL '{GRAFANA_FIXTURE_URL}', PAGE_SIZE '7');

statement ok
ATTACH 'grafana' AS g3 (TYPE vgi, LOCATION '{GRAFANA_WORKER}', secret_name 'org_viewer');

query ITT
SELECT org_id, name, is_current FROM g3.main.orgs;
----
1	Main Org.	true

statement ok
DETACH g2;

statement ok
DETACH g3;
