query ITTTTTTT
SELECT id, type, time, time_end, is_region, text, tags, dashboard_uid FROM grafana.main.annotations WHERE type = 'annotation' ORDER BY id;
----
1	annotation	2026-01-01 00:00:00+00	2026-01-01 00:00:00+00	false	Deploy web v1.2.3	[deploy, web]	web-overview
2	annotation	2026-01-01 02:00:00+00	2026-01-01 02:00:00+00	false	Deploy web v1.2.4	[deploy, web]	web-overview
3	annotation	2026-01-01 03:00:00+00	2026-01-01 04:00:00+00	true	Incident: elevated 5xx	[incident, web]	web-overview
4	annotation	2026-01-01 01:00:00+00	2026-01-01 03:00:00+00	true	Database maintenance	[maintenance, db]	NULL
5	annotation	2026-01-01 05:00:00+00	2026-01-01 05:00:00+00	false	Office party	[social]	NULL
6	annotation	2026-01-01 05:00:00+00	2026-01-01 05:00:00+00	false	Price change	[finance]	revenue

# Time window pushdown (and window splitting at PAGE_SIZE 2).
query IT
SELECT id, text FROM grafana.main.annotations WHERE time >= TIMESTAMPTZ '2026-01-01 01:00:00+00' AND time < TIMESTAMPTZ '2026-01-01 04:00:00+00' ORDER BY time, id;
----
4	Database maintenance
2	Deploy web v1.2.4
3	Incident: elevated 5xx

query IT
SELECT id, text FROM grafana.main.annotations WHERE time BETWEEN TIMESTAMPTZ '2026-01-01 02:00:00+00' AND TIMESTAMPTZ '2026-01-01 02:00:00+00';
----
2	Deploy web v1.2.4

query IT
SELECT id, text FROM grafana.main.annotations WHERE list_contains(tags, 'deploy') ORDER BY id;
----
1	Deploy web v1.2.3
2	Deploy web v1.2.4

query II
SELECT id, panel_id FROM grafana.main.annotations WHERE dashboard_uid = 'web-overview' AND panel_id = 4;
----
3	4

query TT
SELECT type, new_state FROM grafana.main.annotations WHERE type = 'alert';
----
alert	Alerting

query I
SELECT count(*) FROM grafana.main.annotations WHERE time > TIMESTAMPTZ '2099-01-01 00:00:00+00';
----
