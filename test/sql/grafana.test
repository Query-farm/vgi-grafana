# name: test/sql/grafana.test
# description: SQL tests for the grafana worker against recorded Grafana responses (test/fixture_server)
# group: [grafana]

require vgi

require-env GRAFANA_WORKER

require-env GRAFANA_FIXTURE_URL

require-env GRAFANA_FIXTURE_AUTH_URL

statement ok
ATTACH 'grafana' (TYPE vgi, LOCATION '{GRAFANA_WORKER}');

# vgi-go 0.42.0 cannot decode a pushed TIMESTAMPTZ filter in a non-UTC
# session (README "Known limitations"), so the suite pins UTC.
statement ok
INSTALL icu;

statement ok
LOAD icu;

statement ok
LOAD json;

statement ok
SET TimeZone = 'UTC';

# ------------------------------------------------------------------ secrets

# Without a secret every table says how to create one.
statement error
SELECT * FROM grafana.main.health;
----
CREATE SECRET

statement ok
CREATE SECRET bad_url (TYPE grafana, BASE_URL 'http://admin:pw@127.0.0.1:1');

statement error
SELECT * FROM grafana.main.health;
----
must not contain credentials

statement ok
DROP SECRET bad_url;

statement ok
CREATE SECRET grafana_fixture (TYPE grafana, BASE_URL '{GRAFANA_FIXTURE_URL}', PAGE_SIZE '2');

query TT
SELECT version, database FROM grafana.main.health;
----
12.1.1	ok

# ------------------------------------------------------------------ dashboards (BI shape)

query TTTTTTI
SELECT tool, id, title, folder_uid, folder_title, folder_path, panel_count FROM grafana.main.dashboards ORDER BY id;
----
grafana	revenue	EMEA Revenue	sales-emea	EMEA	/Sales/EMEA	1
grafana	scratch	Scratchpad	NULL	General	/	0
grafana	svc-health	Service Health	ops	Operations	/Operations	4
grafana	web-overview	Web Overview	ops-web	Web	/Operations/Web	6

query TTTT
SELECT id, tags, is_starred, owner FROM grafana.main.dashboards ORDER BY id;
----
revenue	[finance, sales]	false	admin
scratch	[]	false	admin
svc-health	[ops, sla]	false	Anonymous
web-overview	[ops, web]	true	admin

query TTTTTT
SELECT id, version, schema_version, refresh, time_from, provisioned FROM grafana.main.dashboards ORDER BY id;
----
revenue	1	41	NULL	NULL	false
scratch	1	41	NULL	NULL	false
svc-health	1	41	1m	now-6h	true
web-overview	2	41	30s	now-24h	false

query TT
SELECT id, regexp_replace(url, '^http://[^/]+', '') FROM grafana.main.dashboards ORDER BY id;
----
revenue	/d/revenue/emea-revenue
scratch	/d/scratch/scratchpad
svc-health	/d/svc-health/service-health
web-overview	/d/web-overview/web-overview

# Views are not exposed by Grafana OSS: NULL, typed.
query TT
SELECT typeof(last_viewed_at), count(*) FILTER (WHERE last_viewed_at IS NULL AND view_count IS NULL) FROM grafana.main.dashboards GROUP BY ALL;
----
TIMESTAMP WITH TIME ZONE	4

# Pushdown: tag -> tag=, folder_uid -> folderUIDs, id -> dashboardUIDs, starred.
query T
SELECT title FROM grafana.main.dashboards WHERE list_contains(tags, 'ops') ORDER BY title;
----
Service Health
Web Overview

query T
SELECT title FROM grafana.main.dashboards WHERE folder_uid IN ('ops', 'sales-emea') ORDER BY title;
----
EMEA Revenue
Service Health

query T
SELECT title FROM grafana.main.dashboards WHERE id = 'revenue';
----
EMEA Revenue

query T
SELECT title FROM grafana.main.dashboards WHERE is_starred;
----
Web Overview

# Filters the API cannot express are evaluated exactly in the worker.
query T
SELECT title FROM grafana.main.dashboards WHERE title LIKE '%e%' AND folder_path <> '/' ORDER BY title;
----
EMEA Revenue
Service Health
Web Overview

query T
SELECT title FROM grafana.main.dashboards WHERE folder_uid IS NULL;
----
Scratchpad

query T
SELECT title FROM grafana.main.dashboards WHERE updated_at > TIMESTAMPTZ '2020-01-01 00:00:00+00' AND regexp_matches(title, '^(Web|EMEA)') ORDER BY title;
----
EMEA Revenue
Web Overview

# The shared BI shape unions with the other BI workers' tables.
query TTI
SELECT tool, typeof(updated_at), count(*) FROM (SELECT tool, id, title, folder_path, owner, created_at, updated_at, last_viewed_at, view_count, url FROM grafana.main.dashboards UNION ALL BY NAME SELECT tool, id, title, folder_path, NULL AS owner, created_at, NULL AS updated_at, NULL AS last_viewed_at, NULL AS view_count, url FROM grafana.main.folders) GROUP BY ALL ORDER BY ALL;
----
grafana	TIMESTAMP WITH TIME ZONE	9

