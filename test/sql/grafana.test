# A missing dashboard is skipped, not an error.
query I
SELECT count(*) FROM grafana.main.panels WHERE dashboard_uid IN ('svc-health', 'no-such-dashboard');
----
4

query TTTTTT
SELECT dashboard_uid, panel_title, ref_id, datasource_uid, datasource_type, query_text FROM grafana.main.panel_queries ORDER BY dashboard_uid, panel_id, ref_id;
----
revenue	Revenue by country	A	pg-warehouse	grafana-postgresql-datasource	SELECT country, sum(amount) FROM orders GROUP BY country
revenue	Revenue by country	B	testdata	grafana-testdata-datasource	csv_content
svc-health	Request rate	A	prom-prod	prometheus	sum by (service) (rate(http_requests_total[5m]))
svc-health	Request rate	B	prom-prod	prometheus	sum(rate(http_requests_total{code=~"5.."}[5m]))
svc-health	Warehouse orders today	A	pg-warehouse	grafana-postgresql-datasource	SELECT count(*) FROM orders WHERE created_at > now() - interval '1 day'
svc-health	Pulse	A	testdata	grafana-testdata-datasource	predictable_pulse
web-overview	Latency (testdata)	A	testdata	grafana-testdata-datasource	csv_metric_values
web-overview	Slow pages	A	pg-warehouse	grafana-postgresql-datasource	SELECT page, p95_ms FROM page_latency ORDER BY p95_ms DESC LIMIT 10
web-overview	Requests by status	A	prom-prod	prometheus	sum by (code) (rate(http_requests_total{job="web"}[5m]))

query TTT
SELECT panel_title, ref_id, hidden FROM grafana.main.panel_queries WHERE dashboard_uid = 'svc-health' AND expr IS NOT NULL ORDER BY ref_id;
----
Request rate	A	false
Request rate	B	true

query TT
SELECT ref_id, raw_sql FROM grafana.main.panel_queries WHERE dashboard_uid = 'revenue' ORDER BY ref_id;
----
A	SELECT country, sum(amount) FROM orders GROUP BY country
B	NULL

query T
SELECT target_json->>'legendFormat' FROM grafana.main.panel_queries WHERE dashboard_uid = 'svc-health' AND ref_id = 'A' AND panel_id = 1;
----
{{service}}

# Data source usage across dashboards.
query TII
SELECT c.title, count(DISTINCT q.dashboard_uid), count(q.ref_id) FROM grafana.main.connections c LEFT JOIN grafana.main.panel_queries q ON q.datasource_uid = c.id GROUP BY c.title ORDER BY c.title;
----
